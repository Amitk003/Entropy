# LLM Provider (openai or gemini)
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SigNoz
SIGNOZ_API_KEY=
SIGNOZ_URL=http://localhost:8000

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=project-entropy

# Evaluator Agent
SIGNOZ_BACKEND_MODE=rest
